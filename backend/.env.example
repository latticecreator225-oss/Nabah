# ─────────────────────────────────────────────────────────────
# Nabah backend · environment configuration
# Copy this file to `.env` (same directory) and fill in the values.
#   cp backend/.env.example backend/.env
# ─────────────────────────────────────────────────────────────

# MongoDB connection string (required). Local example shown below.
# Atlas example: mongodb+srv://user:pass@cluster.mongodb.net
MONGO_URL=mongodb://localhost:27017

# Database name to use inside that Mongo instance (required).
DB_NAME=nabah

# ─────────── Anthropic (optional) ───────────
# Powers the emotion → ayah reflection (direct Anthropic Messages API — no
# third-party relay). If empty, the app uses its static fallbacks.
ANTHROPIC_API_KEY=
# Model to use; defaults to the latest Opus. Set to a Sonnet/Haiku id to trade
# cost for the reflection quality (e.g. claude-haiku-4-5).
ANTHROPIC_MODEL=claude-opus-4-8

# ─────────── Firebase Cloud Messaging (optional for local) ───────────
# Push delivery goes straight to FCM via a Firebase service account. Provide
# EITHER a path to the service-account JSON, or the JSON inline. If neither is
# set, push runs in a logged no-op mode (the in-app feed still works).
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account", ...}

# ─────────── CORS (production web only) ───────────
# Comma-separated list of allowed web origins. Native mobile clients don't send
# an Origin and are unaffected. Leave empty to use the localhost dev defaults.
ALLOWED_ORIGINS=
