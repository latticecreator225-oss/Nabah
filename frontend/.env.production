# Read automatically by Expo tooling (both `eas build` and `eas update`) when
# NODE_ENV=production — unlike eas.json's build.production.env, which `eas
# update` does not consult. Keep this in sync with eas.json's production
# profile. No secrets here: this is just the public API URL.
EXPO_PUBLIC_BACKEND_URL=https://nabah-api.fly.dev
